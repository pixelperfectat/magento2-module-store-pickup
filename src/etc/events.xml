<?xml version="1.0"?>
<config xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="urn:magento:framework:Event/etc/events.xsd">
    <event name="sales_model_service_quote_submit_success">
        <observer name="pp_store_pickup_order_placement"
                  instance="PixelPerfect\StorePickup\Observer\RunPickupOrderPlacementProcessors"/>
    </event>
    <event name="payment_method_is_active">
        <observer name="pp_store_pickup_restrict_payment"
                  instance="PixelPerfect\StorePickup\Observer\RestrictPaymentForPickup"/>
    </event>
</config>
